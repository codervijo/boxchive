---
import { byFamily, FAMILY_LABELS, type Family } from "../data/pages";

const families: Family[] = ["solutions", "audiences", "guides"];
const year = new Date().getFullYear();
---
<footer class="border-t border-[color:var(--rule)] relative z-[1]">
  <div class="container-prose py-14 grid gap-10 md:grid-cols-4 text-sm">
    <div>
      <p class="font-serif text-xl text-[color:var(--ink)]">Boxchive</p>
      <p class="mt-3 text-[color:var(--ink-soft)] leading-relaxed">
        Searchable archives for institutions with long memories.
      </p>
      <a href="/#assessment" class="btn-ghost mt-4">Free assessment →</a>
    </div>
    {families.map((f) => (
      <nav aria-label={FAMILY_LABELS[f]}>
        <p class="eyebrow mb-4">{FAMILY_LABELS[f]}</p>
        <ul class="space-y-2 text-[color:var(--ink-soft)]">
          {byFamily(f).map((p) => (
            <li><a href={p.path} class="hover:text-[color:var(--oxblood)]">{p.label}</a></li>
          ))}
          {f === "guides" && (
            <li><a href="/guides/" class="hover:text-[color:var(--oxblood)]">All guides</a></li>
          )}
        </ul>
      </nav>
    ))}
  </div>
  <div class="container-prose pb-10 text-xs text-[color:var(--ink-soft)]">
    © {year} Boxchive.
  </div>
</footer>
